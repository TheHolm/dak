{
  "version": "1.0",
  // Global values actions and setup params can read and assign. See the README's
  // "Variables" section and the complete examples/ folder.
  "variables": {
    "step": { "type": "int", "min": 1, "max": 100, "value": 10 }
  },
  "defaults": {
    "short_press_duration": 300,
    "double_click_gap": 300,
    "button_brightness": 50,
    "encoder_brightness": 50,
    "background": "#000000",
    "text_color": "#ffffff"
  },
  "scenes": {
    "on_start": {
      "setup": {
        "1b01": { "type": "image", "params": "/usr/lib/python3/dist-packages/smartcard/wx/resources/reader.ico" },
        "1b02": { "type": "image_exec", "params": "/usr/bin/text2gif -t Start" },
        "1b03": { "type": "text_exec", "params": "/usr/bin/date +%H:%M" },
        "1b04": { "type": "text", "params": "/tmp/aaa.txt" }
      },
      "actions": {
        "1b01": { "short_press": "@", "long_press": "", "double_click": "", "pressed": "", "released": "" },
        "1b02": { "short_press": "@Test", "long_press": "", "double_click": "", "pressed": "", "released": "" },
        "1b04": { "long_press": "$defaults.button_brightness := 100" },
        "timer": { "1": "@Main" }
      }
    },
    "Main": {
      "setup": {
        "1b03": { "type": "text_exec", "params": "/usr/bin/date +%H:%M", "refresh": 1 },
        "1b04": { "type": "text", "params": "/tmp/aaa.txt" }
      },
      "actions": {}
    },
    "Test": {
      "setup": {
        "1b02": { "type": "image_exec", "params": "/usr/bin/text2gif -t Test" },
        "1b03": { "type": "clear" }
      },
      "actions": {
        "1b01": { "short_press": ["/usr/bin/aplay /usr/share/sounds/sound-icons/prompt.wav", "@on_start"], "long_press": "", "double_click": "", "pressed": "", "released": "" },
        "1e01": { "turn_cw": "@", "turn_ccw": "@Test", "pressed": "", "released": "", "short_press": "", "long_press": "", "double_click": "" },
        "timer": { "1": "@" }
      }
    }
  },
  "devices": {
    "1": {
      "device_id": "0300:3002",
      "device_name": "Ajazz HOTSPOTEKUSB HID DEMO",
      "serial": "unknown",
      "key_count": 9,
      "encoder_count": 3,
      "screens": 6,
      "protocol_version": 2,
      "buttons": [
        { "number": 1, "press": 1, "release": 1, "screen": true, "draw_id": 1 },
        { "number": 2, "press": 2, "release": 2, "screen": true, "draw_id": 2 },
        { "number": 3, "press": 3, "release": 3, "screen": true, "draw_id": 3 },
        { "number": 4, "press": 4, "release": 4, "screen": true, "draw_id": 4 },
        { "number": 5, "press": 5, "release": 5, "screen": true, "draw_id": 5 },
        { "number": 6, "press": 6, "release": 6, "screen": true, "draw_id": 6 },
        { "number": 7, "press": 37, "release": 37, "screen": false, "draw_id": -1 },
        { "number": 8, "press": 48, "release": 48, "screen": false, "draw_id": -1 },
        { "number": 9, "press": 49, "release": 49, "screen": false, "draw_id": -1 }
      ],
      "encoders": [
        { "number": 1, "cw": 81, "ccw": 80, "press": 53, "release": 53 },
        { "number": 2, "cw": 145, "ccw": 144, "press": 51, "release": 51 },
        { "number": 3, "cw": 97, "ccw": 96, "press": 52, "release": 52 }
      ]
    }
  }
}
