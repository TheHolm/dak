{
  // Push-to-talk. 1b01's `pressed` unmutes the microphone and `released` mutes it
  // again, so holding the button is "talk". These are the low-level edge events: they
  // fire instantly on the down/up edge, unlike short_press/long_press, which only fire
  // on release. `pactl` is required and needs a running sound server.
  //
  // 1b03 is a `launch` slot: entering the scene starts the command fully detached (its
  // own process group, no stdio, left running when dak exits). Nothing is drawn on that
  // button - the reference is only a config slot. Here it starts a dictation daemon;
  // replace it with whatever should run in the background (see `nerd-dictation`).
  "version": "1.0",
  "scenes": {
    "on_start": {
      "setup": {
        "1b01": { "type": "text_value", "params": "TALK" },
        "1b02": { "type": "text_value", "params": "MIC" },
        "1b03": { "type": "launch", "params": "/usr/bin/nerd-dictation begin" }
      },
      "actions": {
        "1b01": {
          "pressed": "/usr/bin/pactl set-source-mute @DEFAULT_SOURCE@ 0",
          "released": "/usr/bin/pactl set-source-mute @DEFAULT_SOURCE@ 1"
        },
        "1b02": {
          "short_press": [
            "/usr/bin/pactl set-source-mute @DEFAULT_SOURCE@ toggle",
            "/usr/bin/notify-send dak 'Microphone mute toggled'"
          ]
        }
      }
    }
  },
  "devices": {
    "1": {
      "device_id": "0300:3002",
      "device_name": "Ajazz HOTSPOTEKUSB HID DEMO",
      "serial": "unknown",
      "key_count": 9,
      "encoder_count": 3,
      "screens": 6,
      "protocol_version": 2,
      "buttons": [
        { "number": 1, "press": 1, "release": 1, "screen": true, "draw_id": 1 },
        { "number": 2, "press": 2, "release": 2, "screen": true, "draw_id": 2 },
        { "number": 3, "press": 3, "release": 3, "screen": true, "draw_id": 3 },
        { "number": 4, "press": 4, "release": 4, "screen": true, "draw_id": 4 },
        { "number": 5, "press": 5, "release": 5, "screen": true, "draw_id": 5 },
        { "number": 6, "press": 6, "release": 6, "screen": true, "draw_id": 6 },
        { "number": 7, "press": 37, "release": 37, "screen": false, "draw_id": -1 },
        { "number": 8, "press": 48, "release": 48, "screen": false, "draw_id": -1 },
        { "number": 9, "press": 49, "release": 49, "screen": false, "draw_id": -1 }
      ],
      "encoders": [
        { "number": 1, "cw": 81, "ccw": 80, "press": 53, "release": 53 },
        { "number": 2, "cw": 145, "ccw": 144, "press": 51, "release": 51 },
        { "number": 3, "cw": 97, "ccw": 96, "press": 52, "release": 52 }
      ]
    }
  }
}
