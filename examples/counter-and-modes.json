{
  // Variables. `count` is an int, `mode` is a string, and both are shown on buttons via
  // `text_value`, re-expanded every second by `refresh` so they track changes.
  //
  // The encoder bumps `count`: clockwise uses `=` (strict - an out-of-range result is
  // rejected), counter-clockwise uses `~=` (silently clamps at 0). Button 1b01 resets it.
  // There is no `$count + 1` arithmetic in the config language, so the increment is a
  // `$(command)` substitution that runs `expr`, whose output is converted to the target
  // type. `$count` inside the command is expanded before it runs.
  //
  // The mode buttons assign literal strings (`:=`) or a command's output; `hostname` on
  // 1b04 demonstrates assigning a string from `$(command)`.
  "version": "1.0",
  "variables": {
    "count": { "type": "int", "min": 0, "max": 100, "value": 0 },
    "mode": { "type": "str", "max_length": 16, "value": "MUSIC" }
  },
  "scenes": {
    "on_start": {
      "setup": {
        "1b01": { "type": "text_value", "params": "CNT $count", "refresh": 1 },
        "1b02": { "type": "text_value", "params": "$mode" }
      },
      "actions": {
        "1b01": { "short_press": "$count = 0" },
        "1b02": { "short_press": "$mode := \"MUSIC\"" },
        "1b03": { "short_press": "$mode := \"VIDEO\"" },
        "1b04": { "short_press": "$mode := $(/usr/bin/hostname)" },
        "1e01": {
          "turn_cw": "$count = $(/usr/bin/expr $count + 1)",
          "turn_ccw": "$count ~= $(/usr/bin/expr $count - 1)"
        }
      }
    }
  },
  "devices": {
    "1": {
      "device_id": "0300:3002",
      "device_name": "Ajazz HOTSPOTEKUSB HID DEMO",
      "serial": "unknown",
      "key_count": 9,
      "encoder_count": 3,
      "screens": 6,
      "protocol_version": 2,
      "buttons": [
        { "number": 1, "press": 1, "release": 1, "screen": true, "draw_id": 1 },
        { "number": 2, "press": 2, "release": 2, "screen": true, "draw_id": 2 },
        { "number": 3, "press": 3, "release": 3, "screen": true, "draw_id": 3 },
        { "number": 4, "press": 4, "release": 4, "screen": true, "draw_id": 4 },
        { "number": 5, "press": 5, "release": 5, "screen": true, "draw_id": 5 },
        { "number": 6, "press": 6, "release": 6, "screen": true, "draw_id": 6 },
        { "number": 7, "press": 37, "release": 37, "screen": false, "draw_id": -1 },
        { "number": 8, "press": 48, "release": 48, "screen": false, "draw_id": -1 },
        { "number": 9, "press": 49, "release": 49, "screen": false, "draw_id": -1 }
      ],
      "encoders": [
        { "number": 1, "cw": 81, "ccw": 80, "press": 53, "release": 53 },
        { "number": 2, "cw": 145, "ccw": 144, "press": 51, "release": 51 },
        { "number": 3, "cw": 97, "ccw": 96, "press": 52, "release": 52 }
      ]
    }
  }
}
