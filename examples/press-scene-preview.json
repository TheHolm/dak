{
  // A pressed/released "flash" trick: holding 1b01 switches to the `Preview` scene,
  // which repaints the whole keypad; letting go switches back to `on_start` and restores
  // the original labels.
  //
  // It works because `Preview` redefines the buttons in `setup` but has an empty
  // `actions`, so 1b01's `released` binding is inherited from the previous scene
  // (`on_start`) and still fires - see `scene-carry-over.json` for the inheritance rule
  // this relies on. `pressed`/`released` fire on the down/up edges, so the preview is
  // shown exactly as long as the button is held.
  "version": "1.0",
  "scenes": {
    "on_start": {
      "setup": {
        "1b01": { "type": "text_value", "params": "HOLD" },
        "1b02": { "type": "text_value", "params": "AAA" },
        "1b03": { "type": "text_value", "params": "BBB" },
        "1b04": { "type": "text_value", "params": "CCC" }
      },
      "actions": {
        "1b01": {
          "pressed": "@Preview",
          "released": "@on_start"
        }
      }
    },
    "Preview": {
      "setup": {
        "1b01": { "type": "text_value", "params": "HELD" },
        "1b02": { "type": "text_value", "params": "XXX" },
        "1b03": { "type": "text_value", "params": "YYY" },
        "1b04": { "type": "text_value", "params": "ZZZ" }
      },
      // Deliberately empty: redefining 1b01 here would shadow the inherited `released`.
      "actions": {}
    }
  },
  "devices": {
    "1": {
      "device_id": "0300:3002",
      "device_name": "Ajazz HOTSPOTEKUSB HID DEMO",
      "serial": "unknown",
      "key_count": 9,
      "encoder_count": 3,
      "screens": 6,
      "protocol_version": 2,
      "buttons": [
        { "number": 1, "press": 1, "release": 1, "screen": true, "draw_id": 1 },
        { "number": 2, "press": 2, "release": 2, "screen": true, "draw_id": 2 },
        { "number": 3, "press": 3, "release": 3, "screen": true, "draw_id": 3 },
        { "number": 4, "press": 4, "release": 4, "screen": true, "draw_id": 4 },
        { "number": 5, "press": 5, "release": 5, "screen": true, "draw_id": 5 },
        { "number": 6, "press": 6, "release": 6, "screen": true, "draw_id": 6 },
        { "number": 7, "press": 37, "release": 37, "screen": false, "draw_id": -1 },
        { "number": 8, "press": 48, "release": 48, "screen": false, "draw_id": -1 },
        { "number": 9, "press": 49, "release": 49, "screen": false, "draw_id": -1 }
      ],
      "encoders": [
        { "number": 1, "cw": 81, "ccw": 80, "press": 53, "release": 53 },
        { "number": 2, "cw": 145, "ccw": 144, "press": 51, "release": 51 },
        { "number": 3, "cw": 97, "ccw": 96, "press": 52, "release": 52 }
      ]
    }
  }
}
